# PocketSmart AI Backend Environment Variables
APP_NAME="PocketSmart AI"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
SECRET_KEY="your-super-secret-jwt-key-replace-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local, PostgreSQL for production)
DATABASE_URL="sqlite:///./pocketsmart.db"
# Example PostgreSQL for production:
# DATABASE_URL="postgresql://user:password@localhost:5432/pocketsmart"

# Google Gemini API
GEMINI_API_KEY="your-google-gemini-api-key-here"
GEMINI_MODEL="gemini-3.8-flash"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500"

# File Upload Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS="jpg,jpeg,png,webp"
